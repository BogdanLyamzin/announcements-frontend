# Base REST URL. Add /api here only if your backend uses that prefix.
BACKEND_URL=http://127.0.0.1:3000

# HW 2 uses multipart/form-data; false enables JSON for HW 1 without photos.
NEXT_PUBLIC_UPLOADS_ENABLED=true
# Must match multer.single(...) in the student's backend.
NEXT_PUBLIC_UPLOAD_FIELD=image

# Reserved for the future real-time exercise. No socket connects yet.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
